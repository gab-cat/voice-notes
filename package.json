{
  "name": "voice-notes",
  "version": "0.2.1",
  "description": "Floating window that transcribes WhatsApp voice notes with the Antigravity CLI",
  "private": true,
  "scripts": {
    "postinstall": "bun run scripts/ensure-electrobun-cli.ts",
    "ensure-cli": "bun run scripts/ensure-electrobun-cli.ts",
    "tray-icon": "bun run scripts/build-tray-icon.ts",
    "icons": "bun run scripts/build-icons.ts",
    "start": "bun run ensure-cli && vite build && electrobun dev",
    "dev": "bun run ensure-cli && vite build && electrobun dev --watch",
    "build": "bun run ensure-cli && vite build && electrobun build --env=stable",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "electrobun": "1.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
